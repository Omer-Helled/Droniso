# Copy to .env.local for local development. On Vercel, set these under Project Settings → Environment Variables.

# Contact form email (https://resend.com). Without it the form still works: it hands the message to WhatsApp / email.
RESEND_API_KEY=
# Where inquiries are sent. Defaults to the site's public address.
# CONTACT_TO=dronisoil@gmail.com
# Sender. The default (Resend's shared sender) only delivers to the address the Resend account was opened with.
# After verifying droniso.com in Resend, use e.g.: DronISO <site@droniso.com>
# CONTACT_FROM=DronISO <onboarding@resend.dev>

# The site's public address (canonical links, social previews, sitemap). Leave unset on Vercel:
# the project's production domain is used automatically. Set it at launch if the main domain
# should differ from what Vercel picks, e.g. https://www.droniso.com
# NEXT_PUBLIC_SITE_URL=

# Set to "true" only on the production deployment, after launch, to allow search engine indexing.
NEXT_PUBLIC_SITE_LIVE=false
